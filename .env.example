# ============================================================
# Copy to .env and adjust the values if needed.
# ============================================================

# --- App ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info          # debug | info | warn | error
CORS_ORIGIN=*           # in production, list specific origins separated by commas

# --- Auth (simple JWT, no roles) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql://buddy:buddy@localhost:5432/buddy?schema=public

# --- RabbitMQ ---
RABBITMQ_URL=amqp://buddy:buddy@localhost:5672
RABBITMQ_PREFETCH=2     # how many messages a worker takes at once

# --- Ollama (on a separate machine in the LAN) ---
# On that machine: OLLAMA_HOST=0.0.0.0:11434 and open port 11434.
# The chat/generation model is configured in buddy.config.yaml (generation.model).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768       # nomic-embed-text dimensionality

# --- Queue / throughput estimation ---
WORKER_CONCURRENCY=2
DEFAULT_ETA_SECONDS=20  # initial estimate until real statistics are available

# --- Remote doc connectors (optional) ---
# Only needed if buddy.config.yaml has a source of the matching type.
# Notion: create an internal integration, share the pages/DBs with it, paste its token.
# NOTION_TOKEN=secret_xxx
# NOTION_API_VERSION=2022-06-28
# Confluence Cloud: base URL + account email + API token (Basic auth).
# For Server/Data Center leave CONFLUENCE_USER empty and put a PAT in the token (Bearer).
# CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki
# CONFLUENCE_USER=you@example.com
# CONFLUENCE_TOKEN=xxx
