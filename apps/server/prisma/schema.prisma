// Prisma schema — Postgres + pgvector.
// Vector columns are declared via Unsupported("vector(768)"): Prisma has no
// native vector type, so we do search with a raw query using the <=> operator
// (cosine distance). HNSW indexes are added in a separate SQL migration
// (see docs/configuration.md → section on vector indexes).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum JobStatus {
  queued
  processing
  done
  failed
}

enum MessageChannel {
  api
  telegram
  slack
}

enum JobKind {
  question
  bug_report
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Job {
  id           String         @id @default(uuid())
  userId       String? // owner (JWT subject); null for unauthenticated/messenger sources
  channel      MessageChannel
  externalId   String? // message/chat id in the external messenger
  status       JobStatus      @default(queued)
  kind         JobKind? // determined during the classification step
  question     String
  answer       String?
  sources      Json? // references to the chunks/documents used
  error        String?
  etaSeconds   Int? // estimate at the time of enqueueing
  position     Int? // position in the queue at the time of enqueueing
  processingMs Int? // actual processing time (for ETA statistics)
  createdAt    DateTime       @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  @@index([status])
  @@index([userId])
  @@index([channel, externalId])
}

// Documentation/code chunks for RAG.
model DocChunk {
  id          String  @id @default(uuid())
  collection  String  @default("markdown") // logical set: markdown / frontend / backend / generated-docs ...
  source      String // source type: "markdown", "code", "gitlab", "youtrack"
  path        String // file path / source identifier
  chunkIndex  Int
  content     String
  contentHash String // sha256 of the content — to avoid re-embedding unchanged content
  // 768 = nomic-embed-text dimensionality. If the model changes, update the migration too.
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime @default(now())

  @@unique([collection, path, chunkIndex])
  @@index([collection])
  @@index([source])
  @@index([contentHash])
}

// Semantic answer cache: if a similar question was already answered and the index
// hasn't changed — return the ready answer without calling the LLM.
model AnswerCache {
  id           String  @id @default(uuid())
  question     String
  embedding    Unsupported("vector(768)")?
  answer       String
  sources      Json?
  indexVersion Int     @default(0) // invalidation on reindexing
  createdAt    DateTime @default(now())
}
